# Copy to .env (never commit .env). Everything works with the defaults (offline).

# offline (default, no model) | ollama (local, sovereign) | bedrock (Claude on Amazon Bedrock)
LLM_PROVIDER=offline

# --- Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=60

# --- Claude on Amazon Bedrock (LLM_PROVIDER=bedrock; public documents only) ---
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL=anthropic.claude-opus-5-5
# BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8
# MIXUP_EFFORT=low

# --- Demo / tests ---
# Freeze "today" for the status engine (YYYY-MM-DD)
# MIXUP_TODAY=2026-10-07
# MIXUP_RUNTIME_DIR=data/runtime
