# Inference backend: ollama (dev default) | llamacpp (packaged) | fake (tests / no models installed)
INFERENCE_BACKEND=ollama
LLM_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
# Reranker: crossencoder (sentence-transformers BAAI/bge-reranker-v2-m3) | embedding (cosine fallback) | none
RERANKER=auto
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# llamacpp backend: llama-server binary and GGUF files live in models/
LLAMACPP_SERVER=models/llama-server.exe
LLAMACPP_CHAT_GGUF=models/qwen3-4b-q4_k_m.gguf
LLAMACPP_EMBED_GGUF=models/bge-m3-q8_0.gguf
LLAMACPP_RERANK_GGUF=models/bge-reranker-v2-m3-q8_0.gguf
# Query rewrite: llm (QUERY_REWRITE prompt with timeout, glossary fallback) | glossary (no LLM call)
QUERY_REWRITE_MODE=llm
QUERY_REWRITE_TIMEOUT=8
# Override the per-user data folder (app.db, installed packs, logs)
# PN_DATA_DIR=
# Fixed "today" for status rules and demos (YYYY-MM-DD)
# PN_TODAY=2026-10-07
